  <Source dwd:design-time-name="c59e9aa2-87a9-44ab-8d80-118eb0ae1671">
    <DataSourceViewID>DSV BikeZ</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="bbc18bc9-809c-4110-85e6-9e59a488d511">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

/* KPI 1. Crecimiento de ingresos por ventas */
CREATE MEMBER CURRENTCUBE.[Measures].[Ingresos Periodo Anterior] AS
    ( [Measures].[Monto Ventas], [Fecha Pedido].[Calendario].CurrentMember.PrevMember ),
    FORMAT_STRING = "Currency", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 1 - Crecimiento', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento vs Periodo Anterior] AS
    IIF( IsEmpty([Measures].[Ingresos Periodo Anterior]) OR [Measures].[Ingresos Periodo Anterior] = 0,
         NULL,
         ( [Measures].[Monto Ventas] - [Measures].[Ingresos Periodo Anterior] ) / [Measures].[Ingresos Periodo Anterior] ),
    FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 1 - Crecimiento', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Ingresos Año Anterior] AS
    IIF( [Fecha Pedido].[Calendario].CurrentMember.Level.Ordinal = 0,
         NULL,
         ( [Measures].[Monto Ventas], ParallelPeriod( [Fecha Pedido].[Calendario].[Año], 1, [Fecha Pedido].[Calendario].CurrentMember ) ) ),
    FORMAT_STRING = "Currency", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 1 - Crecimiento', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento Interanual] AS
    IIF( IsEmpty([Measures].[Ingresos Año Anterior]) OR [Measures].[Ingresos Año Anterior] = 0,
         NULL,
         ( [Measures].[Monto Ventas] - [Measures].[Ingresos Año Anterior] ) / [Measures].[Ingresos Año Anterior] ),
    FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 1 - Crecimiento', ASSOCIATED_MEASURE_GROUP = 'Ventas';


/* KPI 2. Tiempo promedio de despacho (días) */
CREATE MEMBER CURRENTCUBE.[Measures].[Tiempo Promedio Despacho] AS
    IIF( [Measures].[Ordenes Base] = 0, NULL, [Measures].[Dias Despacho Orden] / [Measures].[Ordenes Base] ),
    FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 2 - Despacho', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Despacho Tardio] AS
    IIF( [Measures].[Ordenes Base] = 0, NULL, [Measures].[Ordenes Despacho Tardio] / [Measures].[Ordenes Base] ),
    FORMAT_STRING = "0.00%", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 2 - Despacho', ASSOCIATED_MEASURE_GROUP = 'Ventas';


/* KPI 3. Ingresos, volumen y participación por categoría */
CREATE MEMBER CURRENTCUBE.[Measures].[Participacion Ingresos] AS
    IIF( ( [Measures].[Monto Ventas], Root([Producto]) ) = 0, NULL, [Measures].[Monto Ventas] / ( [Measures].[Monto Ventas], Root([Producto]) ) ),
    FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 3 - Catalogo', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Participacion Unidades] AS
    IIF( ( [Measures].[Unidades Vendidas], Root([Producto]) ) = 0, NULL, [Measures].[Unidades Vendidas] / ( [Measures].[Unidades Vendidas], Root([Producto]) ) ),
    FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 3 - Catalogo', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Precio Promedio Unitario] AS
    IIF( [Measures].[Unidades Vendidas] = 0, NULL, [Measures].[Monto Ventas] / [Measures].[Unidades Vendidas] ),
    FORMAT_STRING = "Currency", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 3 - Catalogo', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Unidades Año Anterior] AS
    IIF( [Fecha Pedido].[Calendario].CurrentMember.Level.Ordinal = 0,
         NULL,
         ( [Measures].[Unidades Vendidas], ParallelPeriod( [Fecha Pedido].[Calendario].[Año], 1, [Fecha Pedido].[Calendario].CurrentMember ) ) ),
    FORMAT_STRING = "#,##0", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 3 - Catalogo', ASSOCIATED_MEASURE_GROUP = 'Ventas';


/* KPI 4. Rendimiento comercial y ticket promedio por vendedor */
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio] AS
    IIF( [Measures].[Ordenes] = 0, NULL, [Measures].[Monto Ventas] / [Measures].[Ordenes] ),
    FORMAT_STRING = "Currency", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 4 - Vendedores', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio Fuerza Ventas] AS
    ( [Measures].[Ticket Promedio], [Vendedor].[Fuerza de Ventas].[Tipo Venta].&amp;[Con Vendedor] ),
    FORMAT_STRING = "Currency", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 4 - Vendedores', ASSOCIATED_MEASURE_GROUP = 'Ventas';

CREATE MEMBER CURRENTCUBE.[Measures].[Participacion Vendedor] AS
    IIF( ( [Measures].[Monto Ventas], Root([Vendedor]) ) = 0, NULL, [Measures].[Monto Ventas] / ( [Measures].[Monto Ventas], Root([Vendedor]) ) ),
    FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'KPI 4 - Vendedores', ASSOCIATED_MEASURE_GROUP = 'Ventas';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="e7fc3616-43ea-401d-8e4f-c5cda6008094">
      <ID>KPI</ID>
      <Name>KPI1 Crecimiento Ingresos</Name>
      <AssociatedMeasureGroupID>Vw Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Crecimiento Interanual]</Value>
      <Goal>0.10</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("KPI1 Crecimiento Ingresos")) THEN NULL
    WHEN KPIValue("KPI1 Crecimiento Ingresos") &gt;= KPIGoal("KPI1 Crecimiento Ingresos") THEN 1
    WHEN KPIValue("KPI1 Crecimiento Ingresos") &gt;= 0 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty([Measures].[Crecimiento vs Periodo Anterior]) THEN NULL
    WHEN [Measures].[Crecimiento vs Periodo Anterior] &gt; 0 THEN 1
    WHEN [Measures].[Crecimiento vs Periodo Anterior] = 0 THEN 0
    ELSE -1
END </Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="becb6ad4-db61-4c76-a54e-3fcadd047d6c">
      <ID>KPI 1</ID>
      <Name>KPI2 Tiempo Despacho</Name>
      <AssociatedMeasureGroupID>Vw Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Tiempo Promedio Despacho]</Value>
      <Goal>7</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("KPI2 Tiempo Despacho")) THEN NULL
    WHEN KPIValue("KPI2 Tiempo Despacho") &lt;= KPIGoal("KPI2 Tiempo Despacho") THEN 1
    WHEN KPIValue("KPI2 Tiempo Despacho") &lt;= KPIGoal("KPI2 Tiempo Despacho") * 1.10 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty(( [Measures].[Tiempo Promedio Despacho], [Fecha Pedido].[Calendario].CurrentMember.PrevMember )) THEN NULL
    WHEN [Measures].[Tiempo Promedio Despacho]
         &lt; ( [Measures].[Tiempo Promedio Despacho], [Fecha Pedido].[Calendario].CurrentMember.PrevMember ) THEN 1
    WHEN [Measures].[Tiempo Promedio Despacho]
         = ( [Measures].[Tiempo Promedio Despacho], [Fecha Pedido].[Calendario].CurrentMember.PrevMember ) THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="9e1ed877-073c-451c-9b18-af257128bf4c">
      <ID>KPI 2</ID>
      <Name>KPI3 Volumen Categoria</Name>
      <AssociatedMeasureGroupID>Vw Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Unidades Vendidas]</Value>
      <Goal>[Measures].[Unidades Año Anterior] * 1.10</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIGoal("KPI3 Volumen Categoria")) OR KPIGoal("KPI3 Volumen Categoria") = 0 THEN NULL
    WHEN KPIValue("KPI3 Volumen Categoria") &gt;= KPIGoal("KPI3 Volumen Categoria") THEN 1
    WHEN KPIValue("KPI3 Volumen Categoria") &gt;= [Measures].[Unidades Año Anterior] THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty([Measures].[Unidades Año Anterior]) THEN NULL
    WHEN [Measures].[Unidades Vendidas] &gt; [Measures].[Unidades Año Anterior] THEN 1
    WHEN [Measures].[Unidades Vendidas] = [Measures].[Unidades Año Anterior] THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="c92681bb-204d-493b-8e18-371b0d7d871a">
      <ID>KPI 3</ID>
      <Name>KPI4 Ticket Promedio</Name>
      <AssociatedMeasureGroupID>Vw Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Ticket Promedio]</Value>
      <Goal>[Measures].[Ticket Promedio Fuerza Ventas]</Goal>
      <Status>CASE
    WHEN IsEmpty(KPIValue("KPI4 Ticket Promedio")) THEN NULL
    WHEN KPIValue("KPI4 Ticket Promedio") &gt;= KPIGoal("KPI4 Ticket Promedio") THEN 1
    WHEN KPIValue("KPI4 Ticket Promedio") &gt;= KPIGoal("KPI4 Ticket Promedio") * 0.80 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN [Fecha Pedido].[Calendario].CurrentMember.Level.Ordinal = 0 THEN NULL
    WHEN IsEmpty(( [Measures].[Ticket Promedio], ParallelPeriod([Fecha Pedido].[Calendario].[Año], 1, [Fecha Pedido].[Calendario].CurrentMember) )) THEN NULL
    WHEN [Measures].[Ticket Promedio]
         &gt; ( [Measures].[Ticket Promedio], ParallelPeriod([Fecha Pedido].[Calendario].[Año], 1, [Fecha Pedido].[Calendario].CurrentMember) ) THEN 1
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>