CAST(p.Producto AS NVARCHAR(150)) AS NombreProducto,
    
CAST(p.Color AS NVARCHAR(50)) AS Color,
 p.CategoriaID,
    
CAST(c.Categoria AS NVARCHAR(100)) AS NombreCategoria

FROM Productos p

LEFT JOIN Categorias c ON p.CategoriaID = c.CategoriaID;</property>
