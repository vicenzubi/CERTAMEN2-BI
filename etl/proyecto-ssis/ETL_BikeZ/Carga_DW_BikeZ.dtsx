          SQLTask:Connection="{CDFD7F8D-5B21-43B8-8B95-71E579DB025B}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FactVentas;&#xA;DBCC CHECKIDENT ('dbo.FactVentas', RESEED, 0);&#xA;&#xA;&#xA;DELETE FROM dbo.DimProducto;&#xA;DBCC CHECKIDENT ('dbo.DimProducto', RESEED, 0);&#xA;&#xA;&#xA;DELETE FROM dbo.DimCliente;&#xA;DBCC CHECKIDENT ('dbo.DimCliente', RESEED, 0);&#xA;&#xA;&#xA;DELETE FROM dbo.DimVendedor;&#xA;DBCC CHECKIDENT ('dbo.DimVendedor', RESEED, 0);&#xA;&#xA;&#xA;DELETE FROM dbo.DimTerritorio;&#xA;DBCC CHECKIDENT ('dbo.DimTerritorio', RESEED, 0)&#xA;&#xA;INSERT INTO dbo.DimVendedor (EmpleadoID, Cargo, FechaNacimiento, EstadoCivil, Genero, FechaContratacion, HorasVacaciones)&#xA;&#xA;VALUES (-1, N'Sin Vendedor (Venta Directa)', '1900-01-01', N'N/A', N'N/A', '1900-01-01', 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
